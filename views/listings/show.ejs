<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap');

  * {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    text-decoration: none;
    border: none;
    outline: none;
    list-style: none;
    scroll-behavior: smooth;
    font-family: "playfair Display", serif;
  }

  html {
    font-size: 65.5%;
  }

  :root {
    --main-color: #d30d0d;
    --text-color: #141622;
  }

  .header {
    width: 100%;
    position: sticky;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 9.5%;
    background: #fff;
    box-shadow: 0 0 5px rgba(190, 109, 190, 0.5), 0 0 10px rgba(190, 109, 190, 0.5);
    z-index: 2;
    transition: 0.4s ease;

  }

  .header .logo img {
    width: 150%;
    height: 60px;
    margin-left: -7rem;
  }

  .header nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  nav .navbar .navLink {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    position: relative;
  }

  nav .navbar .navLink li a {
    color: var(--text-color);
    font-size: 1.7rem;
    font-weight: 600;
    position: relative;

  }

  nav .other i {
    font-size: 3rem;
    color: var(--text-color);
    cursor: pointer;
  }

  .navbar .navLink li a:hover,
  .navbar .navLink .other i:hover {
    color: var(--main-color);
  }

  /* responce for navbar */
  @media(max-width:900px) {
    .top-header {
      display: none;
    }

    nav .navbar .navLink {
      position: absolute;
      display: block;
      top: 5.3rem;
      width: 100%;
      left: 0px;
      background-color: #fff;
      box-shadow: 0 0 5px rgba(190, 190, 190, 0.5);
      padding-left: 30px;
      display: none;
      transition: 0.5s ease-in-out;
    }

    nav .navbar .navLink.active {
      display: block;
    }

    nav .navbar li {
      padding: 1rem 0;
    }
  }

  button {

    width: 240px;
    height: 30px;
    background: var(--text-color);
    color: #fff;
    font-size: 20px;
    text-transform: uppercase;
    cursor: pointer;
    transition: 0.5;
  }

  .container {
    width: 80%;
    margin: 40px auto;
    padding: 20px;

    border-radius: 10px;

    background-color: #fff;
  }

  .row {
    font-size: 15px;
  }

  h2 {
    margin-top: 0;
  }

  p {
    margin-bottom: 10px;
  }

  strong {
    font-weight: bold;
  }


  img {
    width: 40%;
    height: 40%;
  }


  /* Responsive design */

  @media only screen and (max-width: 768px) {
    .container {
      width: 90%;
      margin: 20px auto;
    }
  }

  @media only screen and (max-width: 360px) {
    .container {
      width: 100%;
      margin: auto;
      padding: auto;
    }

    header {
      padding: 10px;
    }

    main {
      padding: 10px;
    }

    section {
      padding: 10px;
    }
  }
</style>

<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
</head>

<body>
  <html>
  <header class="header">
    <div class="logo">
      <img src="/img-20250403T053513Z-001/img/logo/Screenshotnew.png" alt="">
    </div>
    <nav>
      <div class="navbar">
        <div class="navLink">
          <li><a href="/home" class="active">HOME</a></li>
          <li><a href="/listings" class="active">BUY USED CAR</a></li>
          <li><a href="/listings/new" class="active">SELL USED CAR</a></li>
          <li><a href="http://127.0.0.1:5000" class="active">PRICE PREDICTION</a></li>
          <li><a href="/washing" class="active">WASHING</a></li>
          <li><a href="/repairing" class="active">REPAIRING</a></li>
        </div>

      </div>
      <div class="other">
        <i class="bx bx-menu-alt-left" id="menuBar"></i>
      </div>
    </nav>
  </header>

  <div class="container">


    <section>
      <div class="row">
        <h2>
          <%= listing.title %>
        </h2>
        <p><img src="<%= listing.image.url %>" alt="insert image"></p>
        <p><strong>Name: </strong><b>
            <%= listing.owner.username %>
          </b></p>
        <p><strong>Description:</strong>
          <%= listing.description %>
        </p>
        <p><strong>Price:</strong>
          <%= listing.price %>
        </p>
        <p><strong>Location:</strong>
          <%= listing.location %>
        </p>
        <p><strong>Country:</strong>
          <%= listing.country %>
        </p>
        <% if(currentUser && currentUser._id.equals(listing.owner._id)) { %>
          <div class="button">
            <a href="/listings/<%= listing._id %>/edit">Edit your listing</a>
          </div><br>
          <div class="button">
            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
              <button>
                Delete this listing
              </button>
          </div>

          </form>
          <% } %>
    </section>

  </div>
  <html>

</body>
<script>
  const flashMessage = document.getElementById('flash-message');
  setTimeout(() => {
    flashMessage.style.display = 'none';
  }, 3000);
</script>
<script>
  // toggle navbar
  let menuBtn = document.querySelector('#menuBar');
  let navBar = document.querySelector('.navLink');

  menuBtn.onclick = () => {
    navBar.classList.toggle('active');
  };
</script>