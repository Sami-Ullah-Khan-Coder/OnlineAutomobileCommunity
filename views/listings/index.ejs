<style>
  /* font */
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap');

  * {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    text-decoration: none;
    border: none;
    outline: none;
    list-style: none;
    scroll-behavior: smooth;
    font-family: "playfair Display", serif;
  }

  html {
    font-size: 65.5%;
  }

  :root {
    --main-color: #d30d0d;
    --text-color: #141622;
    --color-primary: #1743e3;
    --color-white: #eaeaea;
    --color-dark: #333;
    --color-black: #222;


    --primary-color: #da042a;
    --primary-color-dark: #c00427;
    --secondary-color: #15151f;
    --secondary-color-dark: #0a0b0f;
    --text-light: #6b7280;
    --extra-light: #f8f7fd;
    --white: #ffffff;
    --max-width: 1200px;
  }

  .flash-message {
    margin-top: 1rem;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    justify-content: center;
    align-items: center;
  }


  /* header */
  .header {
    width: 100%;
    position: sticky;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 9.5%;
    background: #fff;
    box-shadow: 0 0 5px rgba(190, 109, 190, 0.5), 0 0 10px rgba(190, 109, 190, 0.5);
    z-index: 2;
    transition: 0.4s ease;

  }

  .header .logo img {
    width: 150%;
    height: 60px;
    margin-left: -7rem;
  }

  .header nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  nav .navbar .navLink {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    position: relative;
  }

  nav .navbar .navLink li a {
    color: var(--text-color);
    font-size: 1.7rem;
    font-weight: 600;
    position: relative;

  }

  nav .other i {
    font-size: 3rem;
    color: var(--text-color);
    cursor: pointer;
  }

  .navbar .navLink li a:hover,
  .navbar .navLink .other i:hover {
    color: var(--main-color);
  }

  /* responce for navbar */
  @media(max-width:900px) {
    .top-header {
      display: none;
    }

    nav .navbar .navLink {
      position: absolute;
      display: block;
      top: 5.3rem;
      width: 100%;
      left: 0px;
      background-color: #fff;
      box-shadow: 0 0 5px rgba(190, 190, 190, 0.5);
      padding-left: 30px;
      display: none;
      transition: 0.5s ease-in-out;
    }

    nav .navbar .navLink.active {
      display: block;
    }

    nav .navbar li {
      padding: 1rem 0;
    }
  }

  .all-listing {

    width: 100%;
    text-align: center;
    color: red;
  }

  .contain {
    margin: 3rem;

    gap: 5px;
    max-width: 1200px;
    width: 100%;

  }

  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    width: 100%;
    padding: 10px;
  }

  /* Card Styles */
  .card {
    margin-top: 1.5rem;
    background-color: #ffffff;
    width: 250px;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .card:hover {
    transform: translateY(-10px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
  }

  /* Image Styling */
  .card-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  /* Card Content */
  .card-content {
    width: 100%;
    padding: 15px;
    text-align: center;
  }

  .card-name {
    font-size: 22px;
    color: #333;
    margin-bottom: 10px;
  }

  .card-price {

    flex-wrap: wrap;
    font-size: 14px;
    color: #666;
    line-height: 1.5;

  }

  a {
    text-decoration: none;
    color: #666;
  }

  .contain .all-listing .row .card form button {
    background-color: var(--text-color);
    margin-bottom: 2rem;
    width: 100%;
    height: 12%;
    align-items: center;
    text-align: center;
    justify-content: center;
    color: #fff;
    cursor: pointer;
  }

  .contain .all-listing .row .card form button:hover {
    background-color: var(--main-color);
  }


  /* Responsive Design */
  @media (max-width: 650px) {
    .card {
      width: 90%;
      margin-right: 2rem;
    }
  }

  @media (max-width: 340px) {
    .card {
      width: 80%;
      margin-right: 1rem;
    }

    .contain .all-listing {
      width: 80%;
    }
  }
</style>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
</head>

<body>
  <header class="header">
    <div class="logo">
      <img src="/img-20250403T053513Z-001/img/logo/Screenshotnew.png" alt="">
    </div>
    <nav>
      <div class="navbar">
        <div class="navLink">
          <li><a href="/home" class="active">HOME</a></li>
          <li><a href="/listings" class="active">BUY USED CAR</a></li>
          <li><a href="/listings/new" class="active">SELL USED CAR</a></li>
          <li><a href="http://127.0.0.1:5000" class="active">PRICE PREDICTION</a></li>
          <li><a href="/washing" class="active">WASHING</a></li>
          <li><a href="/repairing" class="active">REPAIRING</a></li>
        </div>

      </div>
      <div class="other">
        <i class="bx bx-menu-alt-left" id="menuBar"></i>
      </div>
    </nav>
  </header>


  <br>
  <div class="flash-message" id="flash-message">
    <h2>
      <%= success %>
        <%= error %>
    </h2>
  </div>
  <div class="contain">
    <div class="all-listing">
      <h1>All Listings for used vehicle</h1>
      <div class="row">

        <% for(listing of allListings){ %>
          <div class="card">

            <a href="/listings/<%= listing._id %>">
              <img src="<%= listing.image.url %>" alt="Profile Image" class="card-img">
              <div class="card-content">
                <h3 class="card-name">
                  <%= listing.title %>
                </h3>
                <p class="card-price"><b>Location:</b>
                  <%= listing.location %>
                </p>
                <p class="card-price"><b>Price:</b>
                  <%= listing.price %>
                </p>
              </div>
            </a>
            <form action="/buynow">
              <button>BuyNow</button>
            </form>
          </div>
          <% } %>

      </div>
    </div>
</body>
<script>
  const flashMessage = document.getElementById('flash-message');
  setTimeout(() => {
    flashMessage.style.display = 'none';
  }, 3000);
</script>
<script>
  // toggle navbar
  let menuBtn = document.querySelector('#menuBar');
  let navBar = document.querySelector('.navLink');

  menuBtn.onclick = () => {
    navBar.classList.toggle('active');
  };
</script>