<style>
    /* font */
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap');

    * {
        padding: 0;
        margin: 0;
        box-sizing: border-box;
        text-decoration: none;
        border: none;
        outline: none;
        list-style: none;
        scroll-behavior: smooth;
        font-family: "playfair Display", serif;
    }

    html {
        font-size: 65.5%;
    }

    :root {
        --main-color: #d30d0d;
        --text-color: #141622;
    }

    .header {
        width: 100%;
        position: sticky;
        left: 0;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 9.5%;
        background: #fff;
        box-shadow: 0 0 5px rgba(190, 109, 190, 0.5), 0 0 10px rgba(190, 109, 190, 0.5);
        z-index: 2;
        transition: 0.4s ease;

    }

    .header .logo img {
        width: 150%;
        height: 60px;
        margin-left: -7rem;
    }

    .header nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
    }

    nav .navbar .navLink {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        position: relative;
    }

    nav .navbar .navLink li a {
        color: var(--text-color);
        font-size: 1.7rem;
        font-weight: 600;
        position: relative;

    }

    nav .other i {
        font-size: 3rem;
        color: var(--text-color);
        cursor: pointer;
    }

    .navbar .navLink li a:hover,
    .navbar .navLink .other i:hover {
        color: var(--main-color);
    }

    /* responce for navbar */
    @media(max-width:900px) {
        .top-header {
            display: none;
        }

        nav .navbar .navLink {
            position: absolute;
            display: block;
            top: 5.3rem;
            width: 100%;
            left: 0px;
            background-color: #fff;
            box-shadow: 0 0 5px rgba(190, 190, 190, 0.5);
            padding-left: 30px;
            display: none;
            transition: 0.5s ease-in-out;
        }

        nav .navbar .navLink.active {
            display: block;
        }

        nav .navbar li {
            padding: 1rem 0;
        }
    }

    /* signup ============== */
    .signup {
        padding: 4rem 3.5%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

    }

    .signup .title {
        font-size: 34px;
        color: #3a3737;
        font-weight: 550;
        padding-bottom: 30px;
        text-align: center;
        position: relative;
    }

    .signup .title h3::before {
        content: '';
        position: absolute;
        width: 200px;
        height: 4px;
        background: var(--main-color);
        bottom: 20px;
        left: 50%;
        transform: translate(-50%);
        border-radius: 5px;
        animation: animate 8s linear infinite;
    }

    @keyframes animate {
        0% {
            width: 0px;
        }
    }

    .signup form {
        width: 50%;
        margin: 40px auto;
    }

    .signup form .input {
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }

    .signup form .input .inputBx {
        display: flex;
        flex-direction: column;

    }
    .signup form .input .inputBx p{
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 1.5rem;
        margin-top: 3rem;

    }

    .signup form .input .inputBx input {
        width: 100%;
        padding: 10px 3px;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
        font-size: 16px;
        border-radius: 3px;
    }

    .signup form .input .inputBx input:focus {
        border: 1px solid var(--main-color);
        box-shadow: none;
    }

    .signup form .input .inputBx label {
        padding: 6px;
        margin-top: 20px;
        font-size: 17px;
        color: #3a3737;
    }

    .signup form .submit {
        display: flex;
        text-align: center;
        align-items: center;
        justify-content: center;
    }

    .signup form .submit button {
        margin: 30px 0 10px;
        width: 250px;
        height: 40px;
        background: var(--text-color);
        color: #fff;
        font-size: 20px;
        text-transform: uppercase;
        border-radius: 5px;
        cursor: pointer;
        transition: 0.5;
    }

    .signup form .submit button:hover {
        background: var(--main-color);
    }

    .flash-message {

        font-size: 15px;

        text-align: center;
        justify-content: center;
        align-items: center;
    }
</style>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
</head>

<body>
    <header class="header">
        <div class="logo">
            <img src="/img-20250403T053513Z-001/img/logo/Screenshotnew.png" alt="">
        </div>
        <nav>
            <div class="navbar">
                <div class="navLink">
                    <li><a href="/home" class="active">HOME</a></li>
                    <li><a href="/listings" class="active">BUY USED CAR</a></li>
                    <li><a href="/listings/new" class="active">SELL USED CAR</a></li>
                    <li><a href="http://127.0.0.1:5000" class="active">PRICE PREDICTION</a></li>
                    <li><a href="/washing" class="active">WASHING</a></li>
                    <li><a href="/repairing" class="active">REPAIRING</a></li>
                </div>

            </div>
            <div class="other">
                <i class="bx bx-menu-alt-left" id="menuBar"></i>
            </div>
        </nav>
    </header>
    <div class="signup">
        <div class="title">
            <h3>Customer Login Form</h3>
        </div>
        <p class="flash-message" id="flash-message">
            <%= error %>
        </p>

        <form action="/login" method="post">
            <div class="input">
                <div class="inputBx">
                    <label for="name">Name:</label>
                    <input type="text" name="username" id="name" placeholder="Enter Your Name">
                </div>
                <div class="inputBx">
                    <label for="password">Password:</label>
                    <input type="text" name="password" id="password" placeholder="Enter Your password">
                </div>
                <div class="inputBx">
                <p>If you have no account:  <a href="/signup"> SignUp</a></p>
                </div>
            </div>
            <div class="submit">
                <button>Login</button>
            </div>
        </form>
    </div>
</body>

</html>
<script>
    // toggle navbar
    let menuBtn = document.querySelector('#menuBar');
    let navBar = document.querySelector('.navLink');

    menuBtn.onclick = () => {
        navBar.classList.toggle('active');
    };
</script>
<script>
    const flashMessage = document.getElementById('flash-message');
    setTimeout(() => {
        flashMessage.style.display = 'none';
    }, 6000);
</script>